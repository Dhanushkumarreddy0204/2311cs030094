{
  "info": {
    "name": "Campus Evaluation Notification System",
    "description": "API collection for the Full Stack Notification System (Stages 1-7)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Fetch Notifications",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/v1/notifications?page=1&limit=10",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "v1",
            "notifications"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            },
            {
              "key": "notification_type",
              "value": "Placement",
              "disabled": true
            },
            {
              "key": "isRead",
              "value": "false",
              "disabled": true
            }
          ]
        }
      }
    },
    {
      "name": "Fetch Unread Count",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/v1/notifications/unread-count",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "v1",
            "notifications",
            "unread-count"
          ]
        }
      }
    },
    {
      "name": "Mark Single Read",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/v1/notifications/1/read",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "v1",
            "notifications",
            "1",
            "read"
          ]
        }
      }
    },
    {
      "name": "Mark All Read",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/v1/notifications/read-all",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "v1",
            "notifications",
            "read-all"
          ]
        }
      }
    },
    {
      "name": "Create Notification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Urgent Placement Drive\",\n    \"message\": \"Google is coming to campus tomorrow.\",\n    \"type\": \"Placement\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/v1/notifications",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "v1",
            "notifications"
          ]
        }
      }
    },
    {
      "name": "Delete Notification",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://localhost:5000/api/v1/notifications/1",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "v1",
            "notifications",
            "1"
          ]
        }
      }
    }
  ]
}
